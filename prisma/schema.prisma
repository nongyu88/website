generator client {
  provider      = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model domain {
  id                   String   @id @default(uuid())
  name                 String
  users                User[]

  companySize   String?
  taxId         String?
  businessLogo  String? @db.NVarChar(Max)
}

model User {
  id                     String   @id @default(uuid())
  email                  String   @unique
  password               String
  company                String?
  copilotPromptsLeft     Int      @default(20)
  isApproved             Boolean  @default(false)
  createdAt              DateTime @default(now())

  complianceDocs   String?   @db.Text

  lastLoginAt            DateTime? // <-- NEW: Track last login

  hasCompletedOnboarding Boolean  @default(false)
  industry               String?  
  region                 String?  
  alertFocus             String?  

// --- PROFESSIONAL PROFILE FIELDS ---
  position               String?
  department             String?
  bio                    String?   @db.NVarChar(Max)
  linkedinUrl            String?
  timezone               String?
  skills                 String?   @db.NVarChar(Max) // Stored as comma-separated values or text
  workingHours           String?

  // --- NEW: EXTENDED PROFILE FIELDS ---
  firstName              String?
  lastName               String?
  website                String?
  avatarUrl              String?  // Will store the URL of their uploaded logo/photo
  
  // --- NEW: COMMUNICATION PREFS ---
  notifySecurityAlerts   Boolean  @default(true)
  notifyProductUpdates   Boolean  @default(false)

  // --- SUBSCRIPTION & BILLING FIELDS (Updated for SQL Server) ---
  planTier               String    @default("none") // 'none', 'core', 'professional', 'enterprise'
  subscriptionStatus     String    @default("inactive") // 'active', 'past_due', 'canceled', 'inactive'
  stripeCustomerId       String?   // Removed @unique to fix SQL Server NULL constraint
  stripeSubscriptionId   String?   // Removed @unique to fix SQL Server NULL constraint
  currentPeriodEnd       DateTime? 


  role           String        @default("Viewer") // 'Owner', 'Admin', 'Viewer'

  activePlans          String   @default("[]") @db.NVarChar(Max)
  serviceProgress        String   @default("{}") @db.NVarChar(Max)
  
  domainId       String?
  domain         domain?  @relation(fields: [domainId], references: [id])
  reports        Report[]

  // OTP Verification Fields
  emailVerified   DateTime?
  verificationOtp String?
  otpExpiresAt    DateTime?

  // 2FA TOTP Fields
  twoFactorSecret    String?
  isTwoFactorEnabled Boolean  @default(false)
}


// 3. Create a secure vault for pending invites
model Invite {
  id             String       @id @default(uuid())
  email          String
  role           String
  token          String       @unique // A secure random string
  status         String       @default("pending") // 'pending', 'accepted'
  createdAt      DateTime     @default(now())
}


// Add to schema.prisma

model Report {
  id          String   @id @default(uuid())
  reportId    String   @unique // e.g., "REP-091"
  subject     String   
  source      String   // "Automated API" | "Sensor Telemetry" | "UAV Data Upload"
  riskLevel   String   
  metrics     String   @db.NVarChar(Max)
  fileUrl     String?  // Link to uploaded UAV file in S3/Azure
  createdAt   DateTime @default(now())

  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
}

model TelemetryLog {
  id        String   @id @default(uuid())
  sensorId  String
  pressure  Float
  temp      Float
  strain    Float
  timestamp DateTime @default(now())
}