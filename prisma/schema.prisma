generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlserver"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  company   String?
  isApproved Boolean  @default(false)
  createdAt DateTime @default(now())
}